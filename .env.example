# 复制为 .env 后填入真实值
# 注意：不要带 channel_binding=require（node-pg 不兼容，登录会失败）
# 即使控制台复制带了该参数，代码也会自动去掉
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST:5432/postgres?sslmode=require

# 火山方舟 ARK（共用 Key）
ARK_API_KEY=your_ark_api_key
ARK_BASE_URL=https://ark.cn-beijing.volces.com/api/v3
ARK_IMAGE_MODEL=doubao-seedream-5-0-pro-260628
ARK_VISION_MODEL=doubao-seed-evolving
# 默认尺寸（前端可选比例会覆盖）：如 2048x2048 / 1728x2304
ARK_IMAGE_SIZE=2048x2048

# Coze 对象存储（扣子编程 S3）
# 文档：https://docs.coze.cn/guides_integrate_storage_sdk
# 部署在扣子编程项目内时，平台通常会自动注入 COZE_BUCKET_* 与 workload identity token
COZE_BUCKET_ENDPOINT_URL=
COZE_BUCKET_NAME=
COZE_BUCKET_REGION=cn-beijing
# 扣子编程鉴权用 workload identity，access/secret 填占位即可（SDK 内部注入 x-storage-token）
# COZE_BUCKET_ACCESS_KEY=coze
# COZE_BUCKET_SECRET_KEY=coze
# 本地调试可手动设置（扣子运行环境一般不需要）
# COZE_WORKLOAD_IDENTITY_TOKEN=
